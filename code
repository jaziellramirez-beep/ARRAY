//FUNCTIONS


// put all array elements to empty strings
void initializeArray(string dictArray[], int size) {
    for (int i = 0; i < size; i++) {
        dictArray[i] = "";
    }
}



// FUNCTION ACCESS THE FILE AND UPDATE
bool populateArray(string dictArray[], int size, string filename) {
    ifstream inputFile(filename);
    
    // SEE IF FILE EXIST
    if (!inputFile.is_open()) {
        return false; 
    }

    string word;
    int count = 0;
    
    //READ EACH LINE
    while (count < size && inputFile >> word) {
        dictArray[count] = word;
        count++;
    }

    inputFile.close();
    return true; 
}



// FUNCTION REPEATS TO FIND WORDS 
int countNonEmptyWords(const string dictArray[], int size) {
    int count = 0;
    for (int i = 0; i < size; i++) {
        if (dictArray[i] != "") {
            count++;
        }
    }
    return count;
}



// FUNCTION TO DISPLAY FORMAT AND CONTENT OF THE WORD
void printArray(const string dictArray[], int size) {
    for (int i = 0; i < size; i++) {
        // ONLY PRINTS AND DISPLAY WORDS
        if (dictArray[i] != "") {
            cout << (i + 1) << " " << dictArray[i] << endl;
        }
    }
}
